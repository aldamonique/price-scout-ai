SERPAPI_KEY=
OPENAI_API_KEY=
AGENT__MODEL=gpt-6.1-sol
AGENT__REASONING_EFFORT=medium
AGENT__INPUT_USD_PER_MTOK=2
AGENT__OUTPUT_USD_PER_MTOK=10

JUDGE__MODEL=gpt-6.1-terra
JUDGE__REASONING_EFFORT=low
JUDGE__INPUT_USD_PER_MTOK=1
JUDGE__OUTPUT_USD_PER_MTOK=5

AGENT__PROMPT_VERSION=v7
JUDGE__PROMPT_VERSION=v2

# Bronze storage. local = data/bronze/. s3 = a bucket: LocalStack (docker compose up) or AWS.
LAKE__BACKEND=local
LAKE__BUCKET=price-scout-lake
LAKE__ENDPOINT=localhost:4566
LAKE__USE_SSL=false
LAKE__REGION=us-east-1
LAKE__ACCESS_KEY_ID=
LAKE__SECRET_ACCESS_KEY=

# Protection for a public demo. Requests per hour across all users (null = no limit),
# and the token required to delete requests and to read observability (empty = open).
MAX_REQUESTS_PER_HOUR=30
ADMIN_TOKEN=
